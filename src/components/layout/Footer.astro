---
import { profile } from '@/data/profile';
import { socialLinks } from '@/data/social';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[#d8d6cf] sm:mt-28">
  <div class="mx-auto max-w-6xl px-5 py-9 sm:px-8">
    <div class="flex flex-col justify-between gap-7 sm:flex-row sm:items-end">
      <div>
        <a href="/" class="font-serif text-xl font-semibold text-[#172033] hover:text-[#DF5B38]">
          {profile.name}
        </a>
        <p class="mt-1 max-w-md text-sm leading-relaxed text-[#73766f]">
          Cybersecurity research for connected, autonomous, and cyber-physical systems.
        </p>
      </div>
      <nav aria-label="Social links" class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-[#666a73] transition-colors hover:text-[#DF5B38]"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="mt-8 flex flex-col justify-between gap-2 border-t border-[#d8d6cf] pt-5 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[#92948e] sm:flex-row">
      <span>© {year} {profile.name}</span>
      <span>Padova, Italy · Built with Astro</span>
    </div>
  </div>
</footer>
