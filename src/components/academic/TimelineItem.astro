---
interface Props {
  period: string;
  title: string;
  subtitle?: string;
  description?: string;
  last?: boolean;
}

const { period, title, subtitle, description, last = false } = Astro.props;
---

<div data-reveal class={`interactive-row relative flex gap-6 ${last ? '' : 'pb-8'}`}>
  <!-- Timeline line and dot -->
  <div class="flex flex-col items-center">
    <div class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#DF5B38]"></div>
    {!last && <div class="mt-2 w-px flex-1 bg-[#d8d6cf]"></div>}
  </div>
  <div class="pb-1">
    <p class="mb-0.5 text-xs font-bold uppercase tracking-[0.08em] text-[#81847f]">{period}</p>
    <h3 class="text-sm font-bold text-[#172033]">{title}</h3>
    {subtitle && <p class="text-sm text-[#555b67]">{subtitle}</p>}
    {description && <p class="mt-1 text-sm leading-relaxed text-[#73766f]">{description}</p>}
  </div>
</div>
