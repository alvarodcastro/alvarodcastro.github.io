---
import type { CollectionEntry } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, role, status, technologies, links } = project.data;

const statusVariant: Record<string, 'success' | 'accent' | 'muted'> = {
  active: 'success',
  completed: 'accent',
  archived: 'muted',
};
---

<article class="border-b border-[#d8d6cf] py-7 last:border-0">
  <div class="flex items-center gap-3 mb-2 flex-wrap">
    <Badge label={status} variant={statusVariant[status] ?? 'default'} />
    <span class="text-xs text-[#73766f]">{role}</span>
  </div>
  <h3 class="mb-2 font-serif text-xl font-medium leading-snug text-[#172033]">{title}</h3>
  <p class="mb-4 max-w-3xl text-sm leading-relaxed text-[#555b67]">{summary}</p>

  {technologies.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-3">
      {technologies.map((tech) => (
        <span class="tag">
          {tech}
        </span>
      ))}
    </div>
  )}

  <div class="flex flex-wrap items-center gap-3 text-sm">
    <a
      href={`/projects/${project.slug}`}
      class="inline-flex items-center rounded-full border border-[#1E3A8A] px-3 py-1.5 font-semibold text-[#1E3A8A] transition-colors hover:border-[#DF5B38] hover:text-[#DF5B38]"
    >
      Project page
    </a>
    {links && Object.values(links).some(Boolean) && (
      <>
      {links.github && (
        <a href={links.github} target="_blank" rel="noopener noreferrer"
           class="text-[#1E3A8A] hover:underline font-medium">GitHub</a>
      )}
      {links.demo && (
        <a href={links.demo} target="_blank" rel="noopener noreferrer"
           class="text-[#1E3A8A] hover:underline font-medium">Demo</a>
      )}
      {links.paper && (
        <a href={links.paper} target="_blank" rel="noopener noreferrer"
           class="text-[#1E3A8A] hover:underline font-medium">Paper</a>
      )}
      </>
    )}
  </div>
</article>
