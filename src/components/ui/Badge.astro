---
interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'success' | 'warning' | 'muted';
  class?: string;
}

const { label, variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-transparent text-[#666a73] border-[#c8c6bf]',
  accent: 'bg-transparent text-[#1E3A8A] border-[#9ca9ce]',
  success: 'bg-transparent text-emerald-800 border-emerald-300',
  warning: 'bg-transparent text-amber-800 border-amber-300',
  muted: 'bg-transparent text-[#81847f] border-[#d8d6cf]',
};
---

<span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-[0.08em] ${variants[variant]} ${className}`}>
  {label}
</span>
