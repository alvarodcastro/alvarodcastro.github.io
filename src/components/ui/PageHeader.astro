---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="border-b border-[#d8d6cf] pb-10 pt-16 sm:pb-12 sm:pt-20">
  <p class="eyebrow mb-4">Alvaro de Castro · {title}</p>
  <h1 class="max-w-4xl font-serif text-4xl font-medium tracking-[-0.035em] text-[#172033] sm:text-6xl">{title}</h1>
  {subtitle && <p class="mt-4 max-w-2xl text-base leading-7 text-[#5f6470] sm:text-lg">{subtitle}</p>}
</div>
