---
interface Props {
  title?: string;
  subtitle?: string;
  id?: string;
  class?: string;
}

const { title, subtitle, id, class: className = '' } = Astro.props;
---

<section id={id} class={`py-14 sm:py-16 ${className}`} aria-labelledby={title ? `${id}-heading` : undefined}>
  {title && (
    <div class="mb-9">
      <h2
        id={id ? `${id}-heading` : undefined}
        class="font-serif text-3xl font-medium tracking-[-0.02em] text-[#172033]"
      >
        {title}
      </h2>
      {subtitle && <p class="mt-2 text-sm text-[#73766f]">{subtitle}</p>}
    </div>
  )}
  <slot />
</section>
