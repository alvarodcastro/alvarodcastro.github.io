---
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Motion from '@/components/ui/Motion.astro';
import { ViewTransitions } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3f1eb" />
    <script is:inline>
      (() => {
        let theme = 'light';

        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') theme = stored;
        } catch {}

        const dark = theme === 'dark';
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#0c111b' : '#f3f1eb');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
    <SEO {...seoProps} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink antialiased">
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Motion />
  </body>
</html>
