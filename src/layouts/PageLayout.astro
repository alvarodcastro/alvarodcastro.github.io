---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Container from '@/components/ui/Container.astro';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  pageTitleMeta?: string;
  pageSubtitle?: string;
  pageSubtitleSecondary?: string;
  ogImage?: string;
}

const { title, description, pageTitle, pageTitleMeta, pageSubtitle, pageSubtitleSecondary, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Container>
    {(pageTitle ?? pageSubtitle ?? pageSubtitleSecondary) && (
      <PageHeader title={pageTitle ?? title} titleMeta={pageTitleMeta} subtitle={pageSubtitle} subtitleSecondary={pageSubtitleSecondary} />
    )}
    <slot />
  </Container>
</BaseLayout>
