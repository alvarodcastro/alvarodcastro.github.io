---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/ui/Section.astro';
import TimelineItem from '@/components/academic/TimelineItem.astro';
import { profile } from '@/data/profile';
import { education, experience, skills, service, awards } from '@/data/experience';

const bioLinks = {
  SecReSy4You: 'https://secresy4you.eu/',
  'SPRITZ Security and Privacy Research Group': 'https://spritz.math.unipd.it/',
  'Prof. Mauro Conti': 'https://www.math.unipd.it/~conti/',
  'Prof. Alessandro Brighente': 'https://www.math.unipd.it/~abrighen/',
} as const;

const escapedBioLinkLabels = Object.keys(bioLinks)
  .sort((a, b) => b.length - a.length)
  .map((label) => label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
const bioLinkPattern = new RegExp(`(${escapedBioLinkLabels.join('|')})`, 'g');
const bioParagraphs = profile.longBio
  .split('\n\n')
  .map((paragraph) => paragraph.split(bioLinkPattern));
---

<PageLayout
  title="About"
  description={`About ${profile.name} — ${profile.title} at ${profile.institution}`}
  pageTitle="About"
  pageSubtitle={profile.title}
  pageSubtitleSecondary={profile.institution}
>
  <!-- Long bio -->
  <Section id="bio">
    <div class="max-w-2xl">
      {bioParagraphs.map((segments) => (
        <p class="text-[#4B5563] leading-relaxed mb-5">
          {segments.map((segment) => bioLinks[segment as keyof typeof bioLinks] ? (
            <a
              href={bioLinks[segment as keyof typeof bioLinks]}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${segment} (opens in a new tab)`}
              class="font-semibold text-[#1E3A8A] underline decoration-[#9ca9ce] decoration-1 underline-offset-[3px] transition-colors duration-300 hover:text-[#DF5B38] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1E3A8A]"
            >
              {segment}<span class="ml-0.5 inline-block text-[0.7em] no-underline" aria-hidden="true">↗</span>
            </a>
          ) : segment)}
        </p>
      ))}
    </div>
  </Section>

  <!-- Prospective students -->
  <Section id="prospective-students" title="For Prospective Students">
    <div class="max-w-2xl">
      <p class="text-[#4B5563] leading-relaxed">{profile.prospectiveStudents}</p>
      <a href="/contact" class="text-link mt-4">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>

  <!-- Experience -->
  <Section id="experience" title="Research Experience">
    <div>
      {experience.map((item, i) => (
        <TimelineItem
          period={item.period}
          title={item.role}
          subtitle={`${item.organisation}, ${item.location}`}
          description={item.description}
          last={i === experience.length - 1}
        />
      ))}
    </div>
  </Section>

  <!-- Education -->
  <Section id="education" title="Education">
    <div>
      {education.map((item, i) => (
        <TimelineItem
          period={item.period}
          title={item.degree}
          subtitle={`${item.institution}, ${item.location}`}
          description={item.description}
          last={i === education.length - 1}
        />
      ))}
    </div>
  </Section>

  <!-- Awards -->
  {awards?.length > 0 && (
    <Section id="awards" title="Awards and Recognition">
      <div class="max-w-2xl space-y-4">
        {awards.map((award) => (
          <div class="flex gap-4">
            <span class="text-sm font-medium text-[#6B7280] w-12 shrink-0">{award.year}</span>
            <div>
              <p class="text-sm font-semibold text-[#111827]">{award.title}</p>
              <p class="text-sm text-[#6B7280]">{award.issuer}</p>
              {award.description && <p class="text-sm text-[#4B5563] mt-0.5">{award.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- Service -->
  {service?.length > 0 && (
    <Section id="service" title="Community & Service">
      <div class="max-w-2xl space-y-2">
        {service.map((item) => (
          <div class="flex gap-4">
            <span class="text-sm text-[#6B7280] w-20 shrink-0">{item.year ?? ''}</span>
            <p class="text-sm text-[#4B5563]">
              <span class="font-medium text-[#111827]">{item.role}</span>
              {' — '}
              {item.href ? (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                  aria-label={`${item.venue} (opens in a new tab)`}
                >
                  {item.venue}<span aria-hidden="true">↗</span>
                </a>
              ) : item.venue}
            </p>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- Languages -->
  <Section id="languages" title="Languages">
    <div class="flex flex-wrap gap-6 max-w-2xl">
      {skills.languages.map((lang) => (
        <div>
          <p class="text-sm font-semibold text-[#111827]">{lang.language}</p>
          <p class="text-sm text-[#6B7280]">{lang.level}</p>
        </div>
      ))}
    </div>
  </Section>
</PageLayout>
