---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/ui/Section.astro';
import TimelineItem from '@/components/academic/TimelineItem.astro';
import { profile } from '@/data/profile';
import { education, experience, skills, service, awards, technicalPractice } from '@/data/experience';
---

<PageLayout
  title="About"
  description={`About ${profile.name} — ${profile.title} at ${profile.institution}`}
  pageTitle="About"
  pageSubtitle={`${profile.title} · ${profile.institution}`}
>
  <!-- Long bio -->
  <Section id="bio">
    <div class="max-w-2xl">
      {profile.longBio.split('\n\n').map((para) => (
        <p class="text-[#4B5563] leading-relaxed mb-5">{para}</p>
      ))}
    </div>
  </Section>

<!-- Experience -->
  <Section id="experience" title="Research Experience">
    <div>
      {experience.map((item, i) => (
        <TimelineItem
          period={item.period}
          title={item.role}
          subtitle={`${item.organisation}, ${item.location}`}
          description={item.description}
          last={i === experience.length - 1}
        />
      ))}
    </div>
  </Section>

  <!-- Education -->
  <Section id="education" title="Education">
    <div>
      {education.map((item, i) => (
        <TimelineItem
          period={item.period}
          title={item.degree}
          subtitle={`${item.institution}, ${item.location}`}
          description={item.description}
          last={i === education.length - 1}
        />
      ))}
    </div>
  </Section>

  <!-- Technical practice -->
  <Section
    id="technical-practice"
    title="Technical practice"
    subtitle="Methods and tools I use to move from a security question to a reproducible experiment."
  >
    <div class="max-w-4xl border-y border-[#c8c6bf]">
      {technicalPractice.map((practice, index) => (
        <article class="grid gap-3 border-b border-[#d8d6cf] py-6 last:border-0 sm:grid-cols-[2.5rem_13rem_1fr] sm:gap-6 sm:py-7">
          <span class="pt-1 text-[0.68rem] font-bold tracking-[0.14em] text-[#DF5B38]">
            0{index + 1}
          </span>
          <div>
            <h3 class="font-serif text-xl font-medium text-[#172033]">{practice.title}</h3>
            <p class="mt-1 text-xs leading-5 text-[#73766f]">{practice.description}</p>
          </div>
          <p class="self-center font-mono text-[0.72rem] font-medium uppercase leading-6 tracking-[0.08em] text-[#555b67]">
            {practice.stack.map((technology, technologyIndex) => (
              <span>
                {technology}
                {technologyIndex < practice.stack.length - 1 && <span class="mx-2 text-[#b0ada6]">/</span>}
              </span>
            ))}
          </p>
        </article>
      ))}
    </div>
  </Section>

  <!-- Awards -->
  {awards?.length > 0 && (
    <Section id="awards" title="Awards and Recognition">
      <div class="max-w-2xl space-y-4">
        {awards.map((award) => (
          <div class="flex gap-4">
            <span class="text-sm font-medium text-[#6B7280] w-12 shrink-0">{award.year}</span>
            <div>
              <p class="text-sm font-semibold text-[#111827]">{award.title}</p>
              <p class="text-sm text-[#6B7280]">{award.issuer}</p>
              {award.description && <p class="text-sm text-[#4B5563] mt-0.5">{award.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- Service -->
  {service?.length > 0 && (
    <Section id="service" title="Academic Service">
      <div class="max-w-2xl space-y-2">
        {service.map((item) => (
          <div class="flex gap-4">
            <span class="text-sm text-[#6B7280] w-20 shrink-0">{item.year ?? ''}</span>
            <p class="text-sm text-[#4B5563]">
              <span class="font-medium text-[#111827]">{item.role}</span>
              {' — '}{item.venue}
            </p>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- Languages -->
  <Section id="languages" title="Languages">
    <div class="flex flex-wrap gap-6 max-w-2xl">
      {skills.languages.map((lang) => (
        <div>
          <p class="text-sm font-semibold text-[#111827]">{lang.language}</p>
          <p class="text-sm text-[#6B7280]">{lang.level}</p>
        </div>
      ))}
    </div>
  </Section>
</PageLayout>
