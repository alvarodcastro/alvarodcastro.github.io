---
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/ui/Section.astro';
import { profile } from '@/data/profile';

const bioLinks = {
  SecReSy4You: 'https://secresy4you.eu/',
  'SPRITZ Security and Privacy Research Group': 'https://spritz.math.unipd.it/',
  'Prof. Mauro Conti': 'https://www.math.unipd.it/~conti/',
  'Prof. Alessandro Brighente': 'https://www.math.unipd.it/~abrighen/',
} as const;

const escapedBioLinkLabels = Object.keys(bioLinks)
  .sort((a, b) => b.length - a.length)
  .map((label) => label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
const bioLinkPattern = new RegExp(`(${escapedBioLinkLabels.join('|')})`, 'g');
const bioParagraphs = profile.longBio
  .split('\n\n')
  .map((paragraph) => paragraph.split(bioLinkPattern));
---

<PageLayout
  title="About"
  description={`About ${profile.name} — ${profile.title} at ${profile.institution}`}
  pageTitle="About"
  pageSubtitle={profile.title}
  pageSubtitleSecondary={profile.institution}
>
  <!-- Long bio -->
  <Section id="bio">
    <div class="max-w-2xl">
      {
        bioParagraphs.map((segments) => (
          <p class="text-[#4B5563] leading-relaxed mb-5">
            {segments.map((segment) =>
              bioLinks[segment as keyof typeof bioLinks] ? (
                <a
                  href={bioLinks[segment as keyof typeof bioLinks]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${segment} (opens in a new tab)`}
                  class="font-semibold text-[#1E3A8A] underline decoration-[#9ca9ce] decoration-1 underline-offset-[3px] transition-colors duration-300 hover:text-[#DF5B38] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1E3A8A]"
                >
                  {segment}
                  <span class="ml-0.5 inline-block text-[0.7em] no-underline" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                segment
              )
            )}
          </p>
        ))
      }
    </div>
  </Section>

  <!-- Prospective students -->
  <Section id="prospective-students" title="For Prospective Students">
    <div class="max-w-2xl">
      <p class="text-[#4B5563] leading-relaxed">{profile.prospectiveStudents}</p>
      <a href="/contact" class="text-link mt-4">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>
</PageLayout>
